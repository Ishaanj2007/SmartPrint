# SmartPrint Local Environment Configuration Example
# Copy this file to .env for local customization

PORT=3000
APP_URL=http://localhost:3000

# Prototype Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD
ADMIN_TOKEN=YOUR_ADMIN_SESSION_TOKEN

# Prototype Print Agent Authentication
AGENT_ID=SHOP_001
AGENT_TOKEN=YOUR_AGENT_SECRET_TOKEN
